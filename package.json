{
  "name": "pumice",
  "version": "0.0.34",
  "description": "Sync, version, and publish your vault over your own self-hosted gRPC server.",
  "main": "main.js",
  "author": "Ji-ho Lee <search5@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/search5/pumice.git"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "lint": "tsc --noEmit && eslint .",
