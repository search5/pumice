  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^8.64.0",
    "esbuild": "^0.21.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "fake-indexeddb": "^6.2.5",
    "obsidian": "latest",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
